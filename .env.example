# ─────────────────────────────────────────────────────────────
# JobBot Sénégal — copier en .env. Aucune valeur n'est obligatoire
# en développement : tout a un défaut fonctionnel en local.
# Voir README.md pour ce qu'il faut poser avant la production.
# ─────────────────────────────────────────────────────────────

# --- Général ---
ENVIRONMENT=dev
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=jobbot
POSTGRES_PASSWORD=jobbot_dev_password
POSTGRES_DB=jobbot

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Healthcheck / webhook ---
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# --- Règles métier (CLAUDE.md §6 et §8) ---
PRO_MONTHLY_QUOTA=25
FREE_TRIAL_APPLICATIONS=2
FREE_DAILY_ALERTS=5
SUBSCRIPTION_PRICE_FCFA=1000
SUBSCRIPTION_DAYS=30
GRACE_PERIOD_DAYS=3
MAX_APPLICATIONS_PER_JOB=15

# --- Scraping (CLAUDE.md §2.4) ---
INGEST_FRAICHEUR_MINUTES=30
INGEST_VERROU_SECONDES=600
SCRAPER_USER_AGENT=JobBotSN/0.1 (+contact: admin@example.sn)
SCRAPER_DELAY_SECONDS=4.0

# --- Authentification (Phase 2) ---
# OBLIGATOIRE en production : sans lui, n'importe qui forge un jeton de session.
# Générer avec : python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=
JWT_DUREE_JOURS=30

# Garde-fous de l'envoi du code. L'endpoint est public : sans eux, on inonde
# l'adresse d'un tiers et on brûle la réputation du domaine d'envoi.
CODE_TTL_SECONDES=300
AUTH_COOLDOWN_SECONDES=60
AUTH_ENVOIS_PAR_HEURE=3
AUTH_ENVOIS_PAR_JOUR=10
AUTH_ENVOIS_PAR_IP_HEURE=10
AUTH_PLAFOND_GLOBAL_JOUR=500

# Plafonds de /auth/code/verifie. Pas de cooldown : un utilisateur qui se
# trompe de chiffre doit pouvoir recommencer tout de suite. C'est la SEULE
# protection contre la force brute : codes.verifier ne détruit plus le code
# sur échec (voir src/core/auth/codes.py).
AUTH_VERIFICATIONS_PAR_HEURE=20
AUTH_VERIFICATIONS_PAR_IP_HEURE=60

# `console` écrit le code dans les logs. Aucun email réel n'est envoyé tant
# qu'aucun nom de domaine n'existe (CLAUDE.md §14.1).
# INTERDIT en production : le démarrage refuse ENVIRONMENT=prod avec
# FOURNISSEUR_COURRIEL=console, quiconque lit les logs pourrait sinon ouvrir
# n'importe quelle session.
FOURNISSEUR_COURRIEL=console

# Destinataire des alertes techniques (scraper cassé, plafond atteint).
# Vide = alertes en logs uniquement.
ADMIN_COURRIEL=

# ─── Confiance au X-Forwarded-For : LIRE AVANT DE RENSEIGNER ────────────────
#
# ÉTAT ACTUEL, À SAVOIR : aucun reverse proxy n'existe dans ce projet. `web`
# est publié en direct sur l'hôte. Tant que c'est le cas, les plafonds
# « par IP » de `core/auth/limites.py` (AUTH_ENVOIS_PAR_IP_HEURE,
# AUTH_VERIFICATIONS_PAR_IP_HEURE) se comportent en réalité comme des
# plafonds GLOBAUX : l'API ne voit qu'une seule adresse, celle du conteneur
# `web`, et tous les visiteurs partagent le même seau. Avec
# AUTH_ENVOIS_PAR_IP_HEURE=10, le 11e visiteur de l'heure lit « Vous avez
# fait trop d'essais » — une phrase qui l'accuse d'un abus qu'il n'a pas
# commis. Dimensionnez donc cette valeur en conséquence, ou acceptez le
# plafond global en connaissance de cause.
#
# Ces deux réglages vont ENSEMBLE ou pas du tout. N'en activer qu'un ne
# protège de rien : c'est le jour où un vrai proxy existe (Phase 6) qu'on
# les renseigne tous les deux, jamais avant.

# Adresses du reverse proxy autorisées à renseigner X-Forwarded-For (uvicorn
# --forwarded-allow-ips). VIDE tant qu'aucun proxy n'existe : une valeur
# livrée par défaut n'apporte rien aujourd'hui et ARME le contournement le
# jour où quelqu'un la recopie en production. Deux risques symétriques :
# vide derrière un vrai proxy fait du plafond par IP un compteur partagé par
# tous les utilisateurs (panne collective, sans le moindre message d'erreur) ;
# une valeur trop large permet à n'importe qui d'usurper son IP via l'en-tête
# et de contourner ce même plafond.
# Le jour où un proxy est posé devant `web` : la valeur est le réseau depuis
# lequel il se connecte à l'API — en Docker Compose, le réseau par défaut est
# en 172.16.0.0/12.
# NE JAMAIS mettre "*" : n'importe qui pourrait alors usurper son IP.
PROXY_IPS_DE_CONFIANCE=

# --- Client web ---
# Port de publication du client web sur l'hôte.
# ATTENTION : ENVIRONMENT=prod pose `secure: true` sur le cookie de session,
# des DEUX côtés (API et web). Sur un VPS sans TLS devant `web`, le navigateur
# jette alors ce cookie en silence : la connexion échoue sans la moindre
# erreur serveur, et l'utilisateur rebondit indéfiniment sur /connexion.
# Passer en prod suppose donc du TLS déjà en place.
WEB_HOST_PORT=3000

# `web` transmet-il le X-Forwarded-For du client à l'API ? `false` par défaut,
# et fermé par défaut est le seul réglage sûr : sans proxy devant lui, le seul
# X-Forwarded-For que Next puisse lire est celui que le CLIENT a écrit. À
# `true` sans proxy réel, n'importe qui contourne les plafonds par IP en
# faisant tourner la valeur de l'en-tête. À passer à `true` uniquement en même
# temps que PROXY_IPS_DE_CONFIANCE ci-dessus.
WEB_DERRIERE_PROXY=false
