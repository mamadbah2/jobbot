# ─────────────────────────────────────────────────────────────
# JobBot Sénégal — copier en .env puis renseigner TELEGRAM_BOT_TOKEN.
# Toutes les autres valeurs ont un défaut fonctionnel en local.
# ─────────────────────────────────────────────────────────────

# --- Général ---
ENVIRONMENT=dev
LOG_LEVEL=INFO

# --- Telegram (SEULE valeur obligatoire) ---
TELEGRAM_BOT_TOKEN=123456:REMPLACER_PAR_VOTRE_TOKEN_BOTFATHER
# polling en dev, webhook en prod (cf. CLAUDE.md §15)
TELEGRAM_MODE=polling
# Timeout court : le FAI local coupe api.telegram.org par intermittence.
TELEGRAM_LONG_POLL_TIMEOUT=2
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# Reçoit les alertes techniques (scraper cassé, coût LLM, paiement manuel).
ADMIN_TELEGRAM_ID=0

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=jobbot
POSTGRES_PASSWORD=jobbot_dev_password
POSTGRES_DB=jobbot

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Healthcheck / webhook ---
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# --- Règles métier (CLAUDE.md §6 et §8) ---
PRO_MONTHLY_QUOTA=25
FREE_TRIAL_APPLICATIONS=2
FREE_DAILY_ALERTS=5
SUBSCRIPTION_PRICE_FCFA=1000
SUBSCRIPTION_DAYS=30
GRACE_PERIOD_DAYS=3
MAX_APPLICATIONS_PER_JOB=15

# --- Scraping (CLAUDE.md §2.4) ---
INGEST_FRAICHEUR_MINUTES=30
INGEST_VERROU_SECONDES=600
SCRAPER_USER_AGENT=JobBotSN/0.1 (+contact: admin@example.sn)
SCRAPER_DELAY_SECONDS=4.0
